        service_name,
        CASE service_type         
            WHEN 'standard' 
                THEN 'STANDARD'         
            WHEN '4_knot'   
                THEN 'FOUR_KNOT'         
            WHEN '2_knot'   
                THEN 'TWO_KNOT'         
            ELSE service_type     
        END AS service_type,
        description,
        base_price,
        estimated_time_minutes,
        is_active,
        created_at,
        updated_at,
        deleted_at 
    FROM
        stringing_services 
    WHERE
        is_active = 1   
        AND deleted_at IS NULL 
